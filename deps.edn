{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM).
 ;; Pinned by git/sha so this repo is standalone-forkable (no
 ;; monorepo-relative :local/root assumption) -- ISIC-0893 needs no
 ;; robotics (blueprint.edn :itonami.blueprint/robotics false: this
 ;; is a back-office coordination actor, never a physical-actuation
 ;; one -- unlike cloud-itonami-isic-0891's robotics-gated extraction).
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/kotoba.langgraph"}}
 :aliases
 {;; monorepo-internal dev -- pin transitive langgraph/langchain to
  ;; local checkouts when working inside the com-junkawasaki superproject.
  :dev {:override-deps
        {io.github.kotoba-lang/langgraph
         {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "saltops.sim"]}
  :render-html {:main-opts ["-m" "saltops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test
         :override-deps {
                         io.github.kotoba-lang/bytes
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.bytes"}
                         io.github.kotoba-lang/coll
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.coll"}
                         io.github.kotoba-lang/edn
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.edn"}
                         io.github.kotoba-lang/error
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.error"}
                         io.github.kotoba-lang/io
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.io"}
                         io.github.kotoba-lang/json
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.json"}
                         io.github.kotoba-lang/langchain
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.langchain"}
                         io.github.kotoba-lang/langgraph
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.langgraph"}
                         io.github.kotoba-lang/set
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.set"}
                         io.github.kotoba-lang/spec
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.spec"}
                         io.github.kotoba-lang/test
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.test"}
                         io.github.kotoba-lang/text
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.text"}
                         io.github.kotoba-lang/walk
                         {:git/url "https://github.com/kotoba-lang/kotoba"
                          :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                          :deps/root "lib/kotoba.walk"}
         }}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
